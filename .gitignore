# Personal data
student_profile.json

# Run-specific logs
reports/ingest_runs/

# Timestamped eval/tuning reports -- regenerated on every run.
# A curated showcase set is force-committed (git ignores these patterns for
# already-tracked files); see reports/README.md for what is kept and why.
reports/golden_eval_*.md
reports/artifacts/
reports/weight_tuning/*.md
reports/weight_tuning/artifacts/

# Streamlit secrets
.streamlit/secrets.toml

# Environment / API keys
.env
.env.*

# NOTE: the following ARE intentionally committed:
#   data/processed/best_weights*.json  (versioned tuning results)
#   data/processed/changes_*.json      (delta reports)
